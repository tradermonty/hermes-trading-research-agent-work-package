# Model provider. Configure whichever provider your Hermes installation uses.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Canonical Claude Trading Skills checkout for external-linked mode.
# Example: /home/monty/src/claude-trading-skills
CLAUDE_TRADING_SKILLS_REPO=

# Market-data integrations. Optional, but some skills require them for full functionality.
FMP_API_KEY=
FINVIZ_API_KEY=

# Brokerage/account integration. Keep paper/read-only by default.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Cron delivery target: local, telegram, discord, slack, origin, etc.
HERMES_CRON_DELIVER=local

# Reporting preferences.
HERMES_TRADING_TIMEZONE=America/Los_Angeles
HERMES_TRADING_REPORT_DIR=reports

# /trade-ticket persistence (TICKET-010, v0.1.6+). The /trade-ticket bundle
# emits a YAML document and a "Suggested save path" hint pointing at this
# directory with the basename <ticket_id>.ticket.yaml. The bundle never
# writes to disk on its own — persistence is operator-confirmed. The literal
# ${HOME} is left as-is here; consumers should expand with
# os.path.expandvars(os.path.expanduser(value)) (the .env parser returns the
# literal). Recommended: a profile-external root so trade artifacts (tickets,
# journal entries, screenshots, soak logs) live together and survive Hermes
# profile reinstall.
HERMES_TRADE_TICKET_DIR=${HOME}/trading-research/tickets
